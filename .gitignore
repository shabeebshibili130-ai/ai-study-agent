# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments & secrets
.env
.venv/
env/
venv/

# Streamlit secrets (never commit)
.streamlit/secrets.toml

# Pytest & testing caches
.pytest_cache/
.coverage
htmlcov/

